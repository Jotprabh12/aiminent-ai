# =============================================================================
# Aiminent AI — Environment Variables
# =============================================================================
# Copy to `.env.local` and fill in real values. `.env*` is gitignored.
# All variables are validated at startup by lib/config/env.ts — the app will
# refuse to boot with an invalid configuration.
#
# NEXT_PUBLIC_* values are exposed to the browser. Everything else is server-
# only; never prefix a secret with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------

# --- Core (required) ---------------------------------------------------------
# Canonical site origin. Used for absolute URLs, canonicals, OG, sitemap.
# Production: Set to https://www.aiminentai.com in Vercel environment.
# Local development: Use localhost (this file is for local dev only).
# If not set, defaults to https://www.aiminentai.com to prevent localhost leaks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Scheduling (M6) ---------------------------------------------------------
# Calendly booking URL — OPTIONAL override. The consultation flow now works
# out of the box with the live event embedded on /book-consultation
# (DEFAULT_CALENDLY_URL in lib/integrations/booking.ts — with the Calendly
# inline widget, no credentials are required in V1).
# Set this only to switch to a different Calendly event.
NEXT_PUBLIC_CALENDLY_URL=""
# Example: NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/aiminentai/consultation"

# --- Email — Resend (M6) -----------------------------------------------------
# Lead notifications are sent to SITE.contactEmail (team@aiminentai.com).
# RESEND_FROM_EMAIL must be a verified sender on your Resend account.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# --- Analytics (optional) ----------------------------------------------------
# Vercel Analytics needs no key on Vercel. The following are future opt-ins.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# =============================================================================
# Future integrations (added when their feature ships — see lib/integrations):
#   WHATSAPP_API_KEY, WHATSAPP_PHONE_ID
#   N8N_WEBHOOK_URL
#   HUBSPOT_API_KEY / ZOHO_CRM_API_KEY / SALESFORCE_API_KEY
#   SLACK_WEBHOOK_URL
# =============================================================================
