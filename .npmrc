# Fail fast if the local Node version doesn't satisfy package.json "engines".
engine-strict=true

# Keep the dependency tree strict (pnpm default) but auto-install peer deps
# so shadcn/ui + Radix peers resolve cleanly.
auto-install-peers=true

# Ignored build scripts (sharp, unrs-resolver) ship prebuilt binaries;
# do not fail install over their skipped postinstall scripts.
strict-dep-builds=false
